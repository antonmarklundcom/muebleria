# ============================================================
# muebleria.com.py — environment variables
# Copy to .env.local for development. In production, set ALL of
# these in Hostinger → your Node.js app → Environment variables.
# NEXT_PUBLIC_* values are embedded in the client bundle at BUILD
# time. Everything else is server-only — NEVER prefix secrets
# with NEXT_PUBLIC_.
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://muebleria.com.py
# WhatsApp number for orders/inquiries, international format without "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=595991000000

# --- Cuotas badge (READ README BEFORE TOUCHING) ---
# off | 12 — keep "off" until Pagopar confirms IN WRITING that
# cuotas sin interés are active for this merchant account.
NEXT_PUBLIC_CUOTAS_BADGE=off

# --- Bank transfer details (Option B, shown to customers) ---
NEXT_PUBLIC_BANK_NAME=Banco Itaú Paraguay
NEXT_PUBLIC_BANK_ACCOUNT=000-000000-00
NEXT_PUBLIC_BANK_RUC=80000000-0
NEXT_PUBLIC_BANK_HOLDER=Razón Social S.A.

# --- Pagopar (server-only secrets) ---
PAGOPAR_PUBLIC_TOKEN=
PAGOPAR_PRIVATE_TOKEN=
# true = sandbox/testing mode (verbose logging; simulates the redirect
# when tokens are missing so the checkout flow can be tested locally)
PAGOPAR_SANDBOX=true

# --- GoHighLevel inbound webhook (server-only) ---
GHL_WEBHOOK_URL=

# --- Google Sheets order backup (server-only) ---
# Service-account email, its private key (keep the \n escapes), and the
# spreadsheet id from the sheet URL. Share the sheet with the service
# account as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=

# --- Cloudflare R2 (S3-compatible) for transfer receipts (server-only) ---
# If absent, receipt uploads gracefully fall back to WhatsApp (never blocks a sale).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket (r2.dev subdomain or custom domain)
R2_PUBLIC_BASE_URL=
